# ─── NextAuth ────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ─── IA — Google Gemini (obrigatório) ────────────────────────────────────────
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── E-mail SMTP (opcional — para notificações de leads) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contato@paulopop.com.br
NOTIFICATION_EMAIL=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Paulo Pop
NEXT_PUBLIC_WHATSAPP=5561912345678

# ─── Mapas (opcional) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
OPENCAGE_API_KEY=

# ─── Upload de arquivos ───────────────────────────────────────────────────────
# NÃO defina UPLOAD_DIR ao rodar localmente com npm run dev.
# O padrão automático (public/uploads) funciona corretamente.
# SOMENTE para Docker: definido automaticamente pelo docker-compose.yml
# UPLOAD_DIR=/app/public/uploads

# ─── Banco de dados (usado apenas fora do Docker) ─────────────────────────────
# No Docker, a DATABASE_URL é configurada automaticamente pelo docker-compose.yml
# Use apenas se rodar fora do Docker (npm run dev local com Postgres externo):
# DATABASE_URL=postgresql://paulopop:***@localhost:5432/paulopop

# ─── IA — Claude/Anthropic (v1.5: análise, busca de amostras, parecer A4) ─────
# Obter em: https://console.anthropic.com (nunca commitar a chave; só no .env.local do servidor)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
