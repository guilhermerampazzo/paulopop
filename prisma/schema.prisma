generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuários / Corretores ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(AGENT)
  phone         String?
  whatsapp      String?
  creci         String?
  bio           String?
  avatarUrl     String?
  company       String?
  companyCreci  String?
  instagram     String?
  facebook      String?
  linkedin      String?
  youtube       String?
  telegram      String?
  twitter       String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  properties    Property[]
  leads         Lead[]
  activities    Activity[]
  blogPosts     BlogPost[]
  marketStudies MarketStudy[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

// ─── Imóveis ──────────────────────────────────────────────────────────────────

model Property {
  id                    String            @id @default(cuid())
  ref                   String            @unique
  slug                  String            @unique

  purpose               PropertyPurpose   @default(RESIDENTIAL)
  transactionType       TransactionType   @default(SALE)
  location              LocationType      @default(BRAZIL)

  status                PropertyStatus    @default(DRAFT)
  contractType          ContractType?
  registrationDate      DateTime          @default(now())
  expiryDate            DateTime?
  hideOnSite            Boolean           @default(false)

  propertyType          String?
  marketStatus          String?
  condition             String?
  category              String?
  landUse               String?
  availabilityDate      DateTime?
  constructionYear      Int?

  price                 Decimal?          @db.Decimal(15, 2)
  priceType             PriceType?
  pricePerSqm           Decimal?          @db.Decimal(10, 2)
  hidePrice             Boolean           @default(false)
  iptu                  Decimal?          @db.Decimal(10, 2)
  iptuPeriod            String?
  condominiumFee        Decimal?          @db.Decimal(10, 2)
  condominiumFeePeriod  String?

  captureCommissionPct  Decimal?          @db.Decimal(5, 2)
  captureCommissionAmt  Decimal?          @db.Decimal(10, 2)
  captureCommissionType CommissionType    @default(PERCENTAGE)
  saleCommissionPct     Decimal?          @db.Decimal(5, 2)
  saleCommissionAmt     Decimal?          @db.Decimal(10, 2)
  saleCommissionType    CommissionType    @default(PERCENTAGE)

  iptuRegistration      String?
  registryNumber        String?
  financialNotes        String?

  totalArea             Decimal?          @db.Decimal(10, 2)
  usefulArea            Decimal?          @db.Decimal(10, 2)
  landArea              Decimal?          @db.Decimal(10, 2)
  cubicVolume           Decimal?          @db.Decimal(10, 2)
  landDimensionWidth    Decimal?          @db.Decimal(10, 2)
  landDimensionLength   Decimal?          @db.Decimal(10, 2)
  floors                Int?
  unitsInBuilding       Int?
  maxOccupancy          Int?
  totalParkingSpots     Int?
  plateRestriction      Boolean           @default(false)

  parkingSpots          ParkingSpot[]

  environments          Int?              @default(0)
  bedrooms              Int?              @default(0)
  bathrooms             Int?              @default(0)
  suites                Int?              @default(0)
  rooms                 Room[]

  zipCode               String?
  address               String?
  number                String?
  complement            String?
  landmark              String?
  neighborhood          String?
  commercialNeighborhood String?
  city                  String?
  state                 String?
  region                String?
  floor                 String?
  buildingFloors        Int?
  latitude              Decimal?          @db.Decimal(10, 7)
  longitude             Decimal?          @db.Decimal(10, 7)
  showFullAddress       Boolean           @default(false)
  keyNumber             String?
  // v1.3 — histórico de preço, redirecionamento de slug antigo e insight de região
  priceHistory          Json?
  previousSlugs         String[]          @default([])
  areaInsightId         String?
  areaInsight           AreaInsight?      @relation(fields: [areaInsightId], references: [id], onDelete: SetNull)

  title                 String?
  description           String?           @db.Text
  marketingDescription  String?           @db.Text
  surroundingsInfo      String?           @db.Text
  titleEn               String?
  descriptionEn         String?           @db.Text

  features              PropertyFeature[]
  lifestyles            PropertyLifestyle[]

  condominiumId         String?
  condominium           Condominium?      @relation(fields: [condominiumId], references: [id])

  empreendimentoId      String?
  empreendimento        Empreendimento?   @relation(fields: [empreendimentoId], references: [id])
  // v1.2 – unidade do empreendimento (bloco / andar / número)
  unitId                String?
  unit                  EmpreendimentoUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  ownerId               String?
  owner                 Contact?          @relation(fields: [ownerId], references: [id])
  ownerName             String?

  agentId               String
  agent                 User              @relation(fields: [agentId], references: [id])
  secondaryAgentId      String?

  portals               PropertyPortal[]
  additionalFees        AdditionalFee[]

  images                PropertyImage[]
  videos                PropertyVideo[]
  documents             PropertyDocument[]
  virtualTourType       VirtualTourType   @default(NONE)
  virtualTourUrl        String?
  externalLink          String?

  marketAnalyses        MarketAnalysis[]
  marketStudies         MarketStudy[]
  leads                 Lead[]
  activities            Activity[]

  // Características livres (ex.: importadas da RE/MAX: "Perto do metrô", "Armário embutido")
  extraFeatures         String[]          @default([])
  constructionMonth     Int?

  // Origem do anúncio (importação por link)
  sourcePortal          String?
  sourceId              String?           @unique
  sourceUrl             String?
  sourceAgentName       String?
  sourceOfficeName      String?
  importedAt            DateTime?

  // v1.1 – varandas (pedido do relatório de correções)
  balconies             Int?

  // v1.1 – venda ou locação concluída: valor final, desconto e tempo de mercado
  soldAt                DateTime?
  listPriceAtSale       Decimal?          @db.Decimal(15, 2)
  salePrice             Decimal?          @db.Decimal(15, 2)
  saleDiscountPct       Decimal?          @db.Decimal(6, 2)
  saleDiscountValue     Decimal?          @db.Decimal(15, 2)
  saleSource            String?
  saleNotes             String?           @db.Text
  showSalePrice         Boolean           @default(false)
  daysOnMarket          Int?

  // v1.1 – senha do relatório do proprietário (hash) e data em que foi gerada
  reportPasswordHash    String?
  reportPasswordSetAt   DateTime?

  views                 Int               @default(0)
  favorites             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  publishedAt           DateTime?

  @@index([status, transactionType, purpose])
  @@index([status, soldAt])
  @@index([city, state])
  @@index([price])
  @@index([slug])
  @@map("properties")
}

enum PropertyPurpose {
  RESIDENTIAL
  COMMERCIAL
}

enum TransactionType {
  SALE
  RENT
}

enum LocationType {
  BRAZIL
  ABROAD
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  SOLD
  RENTED
  INACTIVE
  SUSPENDED
}

enum ContractType {
  EXCLUSIVE
  OPEN
  AUTHORIZATION
}

enum PriceType {
  FIXED
  ON_REQUEST
  NEGOTIABLE
}

enum CommissionType {
  PERCENTAGE
  AMOUNT
}

enum VirtualTourType {
  NONE
  BANIB
  OTHER
}

model ParkingSpot {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  quantity     Int       @default(0)
  type         String?
  @@map("parking_spots")
}

model Room {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  area         Decimal?  @db.Decimal(8, 2)
  description  String?
  @@map("rooms")
}

model PropertyFeature {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature      FeatureType
  @@unique([propertyId, feature])
  @@map("property_features")
}

enum FeatureType {
  POOL
  GARDEN
  GARAGE
  JACUZZI
  SOLAR_HEATING
  ACCEPTS_PETS
  INDIVIDUAL_GAS_METER
  WHEELCHAIR_ACCESSIBLE
  GOURMET_BALCONY
  BARBECUE
  ELEVATOR
  GYM
  PARTY_ROOM
  PLAYGROUND
  SAUNA
  SECURITY_24H
  INTERCOM
  ALARM
  GENERATOR
  FURNISHED
  SEMI_FURNISHED
  AIR_CONDITIONING
  WOOD_FLOOR
  CERAMIC_FLOOR
  MARBLE_FLOOR
}

model PropertyLifestyle {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lifestyle    LifestyleType
  @@unique([propertyId, lifestyle])
  @@map("property_lifestyles")
}

enum LifestyleType {
  RETIREMENT
  WATER_SPRING
  BEACH
  GOLF
  INVESTMENT
  METROPOLIS
  RANCH
  SKI_RESORT
  HOT_CLIMATE
  COUNTRYSIDE
}

model AdditionalFee {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  value        Decimal   @db.Decimal(10, 2)
  period       String?
  @@map("additional_fees")
}

// ─── Imagens ──────────────────────────────────────────────────────────────────

model PropertyImage {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  alt          String?
  caption      String?
  order        Int       @default(0)
  is360        Boolean   @default(false)
  isPanoramic  Boolean   @default(false)
  isCover      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  @@map("property_images")
}

model PropertyVideo {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  youtubeUrl   String?
  platform     String?
  @@map("property_videos")
}

model PropertyDocument {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  url          String
  type         String?
  size         Int?
  isPublic     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  @@map("property_documents")
}

// ─── Portais ──────────────────────────────────────────────────────────────────

model PropertyPortal {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  portalName   String
  active       Boolean   @default(false)
  externalId   String?
  publishedAt  DateTime?
  @@unique([propertyId, portalName])
  @@map("property_portals")
}

// ─── Contatos / CRM ───────────────────────────────────────────────────────────

model Contact {
  id            String        @id @default(cuid())
  name          String
  email         String?
  phone         String?
  whatsapp      String?
  cpf           String?       @unique
  type          ContactType   @default(CLIENT)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ownedProperties Property[]
  leads           Lead[]

  @@map("contacts")
}

enum ContactType {
  CLIENT
  OWNER
  PARTNER
  INVESTOR
}

model Lead {
  id           String      @id @default(cuid())
  propertyId   String?
  property     Property?   @relation(fields: [propertyId], references: [id])
  contactId    String?
  contact      Contact?    @relation(fields: [contactId], references: [id])
  agentId      String?
  agent        User?       @relation(fields: [agentId], references: [id])
  name         String
  email        String?
  phone        String?
  message      String?     @db.Text
  source       LeadSource  @default(SITE)
  status       LeadStatus  @default(NEW)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("leads")
}

enum LeadSource {
  SITE
  WHATSAPP
  PORTAL
  REFERRAL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  CLOSED
  LOST
}

// ─── Condomínios ─────────────────────────────────────────────────────────────

model Condominium {
  id           String      @id @default(cuid())
  name         String
  address      String?
  city         String?
  state        String?
  zipCode      String?
  properties   Property[]
  @@map("condominiums")
}

// ─── Análise de Mercado ───────────────────────────────────────────────────────

model MarketAnalysis {
  id                   String    @id @default(cuid())
  propertyId           String
  property             Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  generatedAt          DateTime  @default(now())
  status               AnalysisStatus @default(PENDING)

  optimisticValue      Decimal?  @db.Decimal(15, 2)
  marketValue          Decimal?  @db.Decimal(15, 2)
  competitiveValue     Decimal?  @db.Decimal(15, 2)

  pricePositioning     String?
  marketDemand         String?
  absoptionTime        Int?

  comparables          Json?
  priceHistory         Json?

  aiSummary            String?   @db.Text
  aiStrengths          Json?
  aiWeaknesses         Json?
  aiOpportunities      Json?
  aiRecommendations    Json?

  avgPricePerSqmRegion Decimal?  @db.Decimal(10, 2)
  priceVariation30d    Decimal?  @db.Decimal(5, 2)
  priceVariation90d    Decimal?  @db.Decimal(5, 2)
  totalListings        Int?

  rawData              Json?

  @@map("market_analyses")
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Estudo de Mercado (v1.2, padrão RE/MAX) ─────────────────────────────────

model MarketStudy {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation(fields: [agentId], references: [id])
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status          String   @default("DRAFT") // DRAFT | DONE
  title           String
  preparedFor     String?
  ownerEmail      String?
  ownerPhone      String?
  studyDate       DateTime @default(now())
  radiusKm        Decimal? @db.Decimal(5,2)
  intro           String?  @db.Text
  methodology     String?  @db.Text
  // imóvel avaliado
  advertiser      String?
  address         String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?
  latitude        Decimal? @db.Decimal(10,7)
  longitude       Decimal? @db.Decimal(10,7)
  propertyType    String?
  purpose         String?
  transactionType String?  @default("SALE")
  areaPrivate     Decimal? @db.Decimal(10,2)
  areaTotal       Decimal? @db.Decimal(10,2)
  bedrooms        Int?
  suites          Int?
  bathrooms       Int?
  parking         Int?
  parkingType     String?
  floor           String?
  buildingFloors  Int?
  elevator        Boolean?
  sunPosition     String?
  condition       String?
  renovation      String?
  renovationNotes String?
  age             Int?
  condoFee        Decimal? @db.Decimal(10,2)
  iptu            Decimal? @db.Decimal(10,2)
  leisure         String?
  demand          String?
  demandNotes     String?
  finishes        Json?
  notes           String?  @db.Text
  photos          Json?
  // cálculo
  competitivePct  Decimal  @default(15) @db.Decimal(5,2)
  optimisticPct   Decimal  @default(10) @db.Decimal(5,2)
  outlierPct      Decimal  @default(30) @db.Decimal(5,2)
  scenario        String   @default("MARKET") // COMPETITIVE | MARKET | OPTIMISTIC
  adjustPct       Decimal? @db.Decimal(6,2)
  adjustNote      String?
  results         Json?
  // acesso público
  publicToken     String?  @unique
  tokenExpiresAt  DateTime?
  samples         MarketStudySample[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId, status])
  @@map("market_studies")
}

model MarketStudySample {
  id            String      @id @default(cuid())
  studyId       String
  study         MarketStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  portal        String?
  url           String?
  advertiser    String?
  location      String?
  sameCondo     Boolean     @default(false)
  price         Decimal?    @db.Decimal(15,2)
  areaPrivate   Decimal?    @db.Decimal(10,2)
  areaTotal     Decimal?    @db.Decimal(10,2)
  bedrooms      Int?
  bathrooms     Int?
  parking       Int?
  floor         String?
  sunPosition   String?
  renovation    String?
  condoFee      Decimal?    @db.Decimal(10,2)
  age           Int?
  distanceKm    Decimal?    @db.Decimal(6,2)
  publishedAt   DateTime?
  daysListed    Int?
  photoUrl      String?
  finishes      Json?
  aiAnalysis    Json?
  notes         String?     @db.Text
  status        String      @default("VALID") // VALID | DISCARDED
  discardReason String?
  tags          String[]    @default([])
  latitude      Decimal?    @db.Decimal(10,7)
  longitude     Decimal?    @db.Decimal(10,7)
  createdAt     DateTime    @default(now())

  @@index([studyId])
  @@map("market_study_samples")
}

// ─── Atividades ───────────────────────────────────────────────────────────────

model Activity {
  id           String        @id @default(cuid())
  propertyId   String?
  property     Property?     @relation(fields: [propertyId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  type         ActivityType
  description  String
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@map("activities")
}

enum ActivityType {
  PROPERTY_CREATED
  PROPERTY_UPDATED
  PROPERTY_PUBLISHED
  PROPERTY_SOLD
  LEAD_RECEIVED
  LEAD_CONTACTED
  VISIT_SCHEDULED
  VISIT_DONE
  DOCUMENT_ADDED
  IMAGE_ADDED
  ANALYSIS_GENERATED
  NOTE_ADDED
}

// ─── Configurações do Site ────────────────────────────────────────────────────

model SiteConfig {
  id                String    @id @default(cuid())
  ownerName         String    @default("Paulo Pop")
  ownerPhotoUrl     String?
  ownerCreci        String?
  ownerBio          String?   @db.Text
  ownerWhatsapp     String?
  ownerPhone        String?
  ownerEmail        String?
  ownerInstagram    String?
  ownerFacebook     String?
  ownerLinkedin     String?
  ownerYoutube      String?
  ownerTelegram     String?
  ownerCompany      String?
  ownerCompanyCreci String?
  ownerTwitter      String?
  ownerAddress      String?
  logoUrl           String?
  ogImageUrl        String?
  metaTitle         String?
  metaDescription   String?
  heroTitle         String?
  heroSubtitle      String?
  heroBgUrl         String?
  footerText        String?
  whatsappMessage   String?
  // Visibilidade das seções da home
  showDestaques     Boolean   @default(true)
  showCompra        Boolean   @default(true)
  showLocacao       Boolean   @default(true)
  showApartamentos  Boolean   @default(true)
  showCasas         Boolean   @default(true)
  showTerrenos      Boolean   @default(true)
  // v1.1 – rastreamento pelo painel (sem deploy)
  ga4Id             String?
  metaPixelId       String?
  gtmId             String?
  // v1.1 – páginas legais editáveis e dados de contato extras
  privacyPolicy     String?   @db.Text
  termsOfUse        String?   @db.Text
  businessHours     String?
  googleBusinessUrl String?
  mapEmbedUrl       String?
  updatedAt         DateTime  @updatedAt

  @@map("site_config")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String?        @db.Text
  content     String         @db.Text
  coverUrl    String?
  category    String?
  tags        String[]       @default([])
  status      BlogPostStatus @default(DRAFT)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  // v1.3 — blog moderno
  sections        Json?
  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?
  readingMinutes  Int?
  citySlug        String?
  series          String?
  featured        Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([citySlug])
  @@map("blog_posts")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

// ─── Empreendimentos ──────────────────────────────────────────────────────────

model Empreendimento {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  tagline         String?
  description     String?  @db.Text
  status          String   @default("DRAFT") // DRAFT | PUBLISHED
  // Localização
  address         String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?
  latitude        Float?
  longitude       Float?
  areaInsightId   String?
  areaInsight     AreaInsight? @relation(fields: [areaInsightId], references: [id], onDelete: SetNull)
  locationDescription String? @db.Text
  // Detalhes técnicos
  architect       String?
  deliveryDate    String?
  totalUnits      Int?
  floors          Int?
  bedroomsMin     Int?
  bedroomsMax     Int?
  suitesMin       Int?
  suitesMax       Int?
  areaMin         Float?
  areaMax         Float?
  priceMin        Decimal? @db.Decimal(15,2)
  priceMax        Decimal? @db.Decimal(15,2)
  // Financiamento
  financing       String?
  paymentInfo     String?  @db.Text
  banks           String?  @db.Text
  // Descrições por seção
  tipologiasDescription String? @db.Text
  lazerDescription      String? @db.Text
  // Mídia
  coverUrl        String?
  logoUrl         String?
  youtubeUrl      String?
  virtualTourUrl  String?
  virtualTourType String?  @default("NONE")
  images          EmpreendimentoImage[]
  floorPlanImages EmpreendimentoFloorPlan[]
  // Diferenciais / amenidades (JSON array de strings)
  amenities       String?  @db.Text
  highlights      String?  @db.Text
  // CTA
  ctaLabel        String?
  ctaWhatsapp     String?
  ctaUrl          String?

  properties      Property[]

  // v1.2 – hub do prédio
  stage           String   @default("ENTREGUE") // LANCAMENTO | EM_OBRAS | ENTREGUE
  deliveryYear    Int?
  builder         String?
  elevators       Int?
  condoFeeAvg     Decimal? @db.Decimal(10,2)
  petsAllowed     Boolean?
  rules           String?  @db.Text
  blocks          EmpreendimentoBlock[]
  unitTypes       EmpreendimentoUnitType[]
  units           EmpreendimentoUnit[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("empreendimentos")
}

// v1.2 – Estrutura do empreendimento: blocos, tipologias e unidades
model EmpreendimentoBlock {
  id                String          @id @default(cuid())
  empreendimentoId  String
  empreendimento    Empreendimento  @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  name              String          // "Bloco A", "Torre 1"
  floors            Int             @default(1)
  unitsPerFloor     Int             @default(4)
  firstFloor        Int             @default(1)   // 0 = térreo
  numbering         String          @default("FLOOR_SEQ") // FLOOR_SEQ: 101,102… | SEQ: 1,2,3…
  order             Int             @default(0)
  units             EmpreendimentoUnit[]

  @@map("empreendimento_blocks")
}

model EmpreendimentoUnitType {
  id                String          @id @default(cuid())
  empreendimentoId  String
  empreendimento    Empreendimento  @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  name              String          // "2 quartos com suíte"
  bedrooms          Int?
  suites            Int?
  bathrooms         Int?
  area              Decimal?        @db.Decimal(10,2)
  parking           Int?
  sunPosition       String?         // nascente, poente…
  floorPlanUrl      String?
  finals            String?         // finais de apartamento: "01,02,05"
  order             Int             @default(0)
  units             EmpreendimentoUnit[]

  @@map("empreendimento_unit_types")
}

model EmpreendimentoUnit {
  id                String          @id @default(cuid())
  empreendimentoId  String
  empreendimento    Empreendimento  @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)
  blockId           String
  block             EmpreendimentoBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  floor             Int
  number            String
  unitTypeId        String?
  unitType          EmpreendimentoUnitType? @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  notes             String?
  properties        Property[]

  @@unique([blockId, number])
  @@index([empreendimentoId])
  @@map("empreendimento_units")
}

model EmpreendimentoImage {
  id                String          @id @default(cuid())
  empreendimentoId  String
  url               String
  thumbnailUrl      String?
  caption           String?
  alt               String?
  order             Int             @default(0)
  category          String          @default("FACHADA") // FACHADA | AREAS_COMUNS | LAZER | LOCALIZACAO
  empreendimento    Empreendimento  @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  @@map("empreendimento_images")
}

model EmpreendimentoFloorPlan {
  id                String          @id @default(cuid())
  empreendimentoId  String
  url               String
  caption           String?
  order             Int             @default(0)
  empreendimento    Empreendimento  @relation(fields: [empreendimentoId], references: [id], onDelete: Cascade)

  @@map("empreendimento_floor_plans")
}

// ─── Depoimentos ─────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  text      String
  rating    Int      @default(5)
  avatarUrl String?
  source    String?  @default("manual")
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// ─── v1.3: páginas editáveis (Cidades, Parceiros), Viver aqui, alertas ─────────

model CityPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       String?
  summary       String?  @db.Text
  coverUrl      String?
  videoUrl      String?
  status        String   @default("DRAFT") // DRAFT | PUBLISHED
  order         Int      @default(0)
  // Dados fixos da cidade / região administrativa
  raNumber      String?
  foundedAt     String?
  founderGovernor String?
  population    String?
  populationSource String?
  areaKm2       String?
  distanceKm    String?
  latitude      Float?
  longitude     Float?
  matchNames    String[] @default([]) // nomes de cidade/bairro dos imóveis que pertencem a esta página
  sections      Json?    // blocos do editor de seções
  seoTitle      String?
  seoDescription String?
  ogImageUrl    String?
  areaInsightId String?
  areaInsight   AreaInsight? @relation(fields: [areaInsightId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, order])
  @@map("city_pages")
}

model Partner {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  type          String   @default("OUTRO") // CONSTRUTORA | BANCO | CARTORIO | REFORMA | MUDANCA | SEGUROS | OUTRO
  tagline       String?
  summary       String?  @db.Text
  logoUrl       String?
  coverUrl      String?
  benefit       String?  @db.Text
  website       String?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  mapEmbedUrl   String?
  instagram     String?
  status        String   @default("DRAFT")
  order         Int      @default(0)
  featured      Boolean  @default(false)
  sections      Json?
  seoTitle      String?
  seoDescription String?
  empreendimentoIds String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, type, order])
  @@map("partners")
}

/** "Viver aqui": pesquisa de região por endereço (cache por endereço, editável). */
model AreaInsight {
  id           String   @id @default(cuid())
  addressKey   String   @unique   // endereço normalizado
  address      String
  latitude     Float?
  longitude    Float?
  data         Json?    // { categorias: [{ key, label, places: [{ name, address, distanceM, walkMin, rating, lat, lng, types }] }], routes: [...], highlights: [...], summary }
  manual       Json?    // ajustes/destaques do corretor
  provider     String?  // google | manual
  fetchedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties      Property[]
  empreendimentos Empreendimento[]
  cityPages       CityPage[]

  @@map("area_insights")
}

/** Alerta de imóvel (busca salva) e avaliação online. */
model PropertyAlert {
  id           String   @id @default(cuid())
  name         String?
  phone        String
  email        String?
  criteria     Json     // { transactionType, propertyType, city, neighborhood, empreendimentoId, minPrice, maxPrice, bedrooms, text }
  source       String   @default("site")
  active       Boolean  @default(true)
  lastNotifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@map("property_alerts")
}
